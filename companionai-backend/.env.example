# Application
APP_NAME=CompanionAI
ENVIRONMENT=development
DEBUG=True
PORT=8000
SECRET_KEY=your-64-character-hex-secret-key-here
API_V1_STR=/api/v1

# Supabase PostgreSQL Database (or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/companionai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# LLM Providers (DeepSeek / OpenAI)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Realtime Voice (WebRTC Speech-to-Speech)
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# HuggingFace (Sentiment / NLP)
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
